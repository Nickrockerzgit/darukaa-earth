# Base URL of the Darukaa.Earth API.
# Local:      http://localhost:8000
# Production: https://darukaa-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Mapbox GL access token (public "pk." token).
# Create one free at https://account.mapbox.com/access-tokens/
# The map renders a clear setup message instead of a blank canvas when unset.
VITE_MAPBOX_TOKEN=

# Mapbox style used by the dashboard map.
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/satellite-streets-v12
