# Normalise line endings in the repository to LF.
* text=auto eol=lf

# Shell scripts and git hooks MUST be LF: CRLF makes them unrunnable on Linux
# (the CI runners) with a "bad interpreter" error that is hard to diagnose.
*.sh text eol=lf
.husky/* text eol=lf

# Windows-only files keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
