# ---- Application ----
ENVIRONMENT=development           # development | staging | production
DEBUG=true
PROJECT_NAME=Darukaa.Earth API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false                    # true in production for structured logs

# ---- Database ----
# Local (docker compose):  postgresql+asyncpg://darukaa:darukaa@db:5432/darukaa
# Native host:             postgresql+asyncpg://darukaa:darukaa@localhost:5433/darukaa
#   (5433, because 5432 is often already taken by a local PostgreSQL)
# Production (Neon): use the POOLED endpoint, and keep the driver as asyncpg.
#   postgresql+asyncpg://USER:PW@ep-xxx-pooler.REGION.aws.neon.tech/darukaa?sslmode=require
# sslmode/channel_binding can stay: app/db/session.py strips the libpq-only
# parameters and requests TLS through connect_args instead.
DATABASE_URL=postgresql+asyncpg://darukaa:darukaa@localhost:5433/darukaa
TEST_# Production (Neon): use the POOLED endpoint, and keep the driver as asyncpg.
#   postgresql+asyncpg://USER:PW@ep-xxx-pooler.REGION.aws.neon.tech/darukaa?sslmode=require
# sslmode/channel_binding can stay: app/db/session.py strips the libpq-only
# parameters and requests TLS through connect_args instead.
DATABASE_URL=postgresql+asyncpg://darukaa:darukaa@localhost:5433/darukaa_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-48-byte-urlsafe-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Demo seed ----
SEED_DEMO_EMAIL=admin@darukaa.earth
SEED_DEMO_PASSWORD=DarukaaDemo123!
